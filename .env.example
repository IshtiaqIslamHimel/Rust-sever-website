```env
NODE_ENV="development"
PORT="3000"
TRUST_PROXY="false"
APP_ORIGIN="http://localhost:3000"

# Frontend only. Leave blank locally; set both in Vercel to the Railway URL.
VITE_API_URL=""
VITE_WS_URL=""

# Long random token required for administrative API routes.
ADMIN_API_TOKEN=""

# Rust server (only game/query ports and IP are public information).
RUST_SERVER_IP=""
RUST_GAME_PORT=""
RUST_QUERY_PORT=""
RUST_RCON_PORT=""
RUST_RCON_PASSWORD=""
RUST_WORLD_SEED=""
RUST_WORLD_SIZE=""
BATTLEMETRICS_SERVER_ID=""

# MySQL database (server-side only).
MYSQL_HOST=""
MYSQL_PORT=""
MYSQL_USER=""
MYSQL_PASSWORD=""
MYSQL_DATABASE=""

# Steam API Integration
STEAM_API_KEY=""

# BattleMetrics API Integration
BATTLEMETRICS_API_KEY=""

# RustMaps API Integration
RUSTMAPS_API_KEY=""
```
