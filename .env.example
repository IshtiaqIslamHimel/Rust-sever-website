# Copy this file to .env and fill in real values. Never commit .env.
NODE_ENV="development"
PORT="3000"
TRUST_PROXY="false"
APP_ORIGIN="http://localhost:3000"
APP_ORIGINS="http://localhost:3000"

# Frontend only. Leave blank locally; set both in Vercel to the Railway URL.
VITE_API_URL=""
VITE_WS_URL=""

# Long random token required for administrative API routes.
ADMIN_API_TOKEN="replace-with-a-long-random-secret"

# Rust server (only game/query ports and IP are public information).
RUST_SERVER_IP="15.235.132.88"
RUST_GAME_PORT="25096"
RUST_QUERY_PORT="25097"
RUST_RCON_PORT="25098"
RUST_RCON_PASSWORD="replace-with-rcon-password"
RUST_WORLD_SEED="8491029"
RUST_WORLD_SIZE="3500"
BATTLEMETRICS_SERVER_ID="40299572"

# MySQL database (server-side only).
MYSQL_HOST="replace-with-mysql-host"
MYSQL_PORT="3306"
MYSQL_USER="replace-with-mysql-user"
MYSQL_PASSWORD="replace-with-mysql-password"
MYSQL_DATABASE="replace-with-mysql-database"

# Steam API Integration
STEAM_API_KEY="replace-with-steam-api-key"

# BattleMetrics API Integration
BATTLEMETRICS_API_KEY="replace-with-battlemetrics-api-key"

# RustMaps API Integration
RUSTMAPS_API_KEY="replace-with-rustmaps-api-key"
